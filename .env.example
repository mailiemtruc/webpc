# CẤU HÌNH HỆ THỐNG WEBPC
APP_NAME="PCMarket - Thế Giới PC & Linh Kiện"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/webpc/public

# CẤU HÌNH CƠ SỞ DỮ LIỆU MYSQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=webpc_db
DB_USER=root
DB_PASS=

# CẤU HÌNH EMAIL SMTP (Khôi phục mật khẩu & thông báo đơn hàng)
# MAIL_DRIVER: smtp (khi triển khai thật), mail (PHP mail), hoặc log (lưu storage/logs/mail.log khi dev local)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@pcmart.vn
MAIL_FROM_NAME="PCMarket"

# MÚI GIỜ
TIMEZONE=Asia/Ho_Chi_Minh
