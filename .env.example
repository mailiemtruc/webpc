# CẤU HÌNH HỆ THỐNG WEBPC
APP_NAME="PCMarket - Thế Giới PC & Linh Kiện"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/webpc/public
# Khóa mã hóa bí mật hệ thống (ví dụ sinh bằng PHP random_bytes(32), dùng mã hóa TOTP 2FA secret)
APP_KEY=

# CẤU HÌNH CƠ SỞ DỮ LIỆU MYSQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=webpc_db
DB_USER=root
DB_PASS=

# CẤU HÌNH EMAIL GMAIL SMTP (Xác nhận tài khoản, Quên mật khẩu, Cảnh báo bảo mật)
# Nếu để trống MAIL_USERNAME / MAIL_PASSWORD, hệ thống tự ghi mail ra storage/logs/mail.log để test local.
# Với Gmail thật: bật xác minh 2 bước Google -> tạo Mật khẩu ứng dụng (App Password 16 ký tự) rồi điền vào đây.
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="PCMarket"

# MÚI GIỜ
TIMEZONE=Asia/Ho_Chi_Minh

# CẤU HÌNH GOOGLE OAUTH 2.0 (ĐĂNG NHẬP / ĐĂNG KÝ BẰNG GOOGLE)
# Tạo OAuth Client ID tại: https://console.cloud.google.com/apis/credentials
# Thêm Authorized redirect URI: http://localhost/webpc/public/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/webpc/public/auth/google/callback

